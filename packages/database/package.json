{
  "name": "@infinityshop/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:superadmin": "tsx prisma/create-superadmin.ts",
    "db:demo": "tsx prisma/sync-demo-store.ts",
    "db:demo:prod": "node dist/prisma/sync-demo-store.js",
    "db:bootstrap-superadmin:prod": "node dist/prisma/bootstrap-superadmin.js",
    "db:studio": "prisma studio",
    "test": "tsx --test test/**/*.test.ts",
    "test:isolation": "tsx --test test/tenant-isolation.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "prisma": "^7.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}
