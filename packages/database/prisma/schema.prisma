generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

enum BranchRole {
  MANAGER
  WAITER
  KITCHEN
  CASHIER
  STAFF
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum TableStatus {
  AVAILABLE
  BLOCKED
  INACTIVE
}

enum MenuItemAvailability {
  AVAILABLE
  SOLD_OUT
  HIDDEN
}

enum DiningOrderSource {
  QR
  WAITER
  POS
}

enum DiningOrderStatus {
  OPEN
  IN_PREPARATION
  READY
  SERVED
  CLOSED
  CANCELLED
}

enum OrderRoundStatus {
  SUBMITTED
  CANCELLED
}

enum KitchenStationType {
  KITCHEN
  BAR
  DESSERT
  OTHER
}

enum KitchenTicketStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PlatformRole {
  USER
  SUPERADMIN
}

enum PlanCode {
  STARTER
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingProvider {
  MERCADO_PAGO
}

enum BillingInvoiceStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  READY_FOR_PICKUP
  PICKED_UP
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  MERCADO_PAGO
  CASH
  CARD_EXTERNAL
  MERCADO_PAGO_EXTERNAL
  OTHER
}

enum OrderPaymentKind {
  PAYMENT
  REFUND
}

enum PaymentFlow {
  STOREFRONT
  POS
}

enum PaymentReconciliationStatus {
  PENDING
  RECONCILED
  MISMATCH
  REFUNDED
}

enum FiscalProvider {
  DISABLED
  EXTERNAL
}

enum FiscalDocumentType {
  INVOICE
  CREDIT_NOTE
}

enum FiscalDocumentStatus {
  PENDING
  ISSUED
  REJECTED
}

enum CashMovementType {
  OPENING
  CASH_SALE
  CASH_REFUND
  INCOME
  EXPENSE
  ADJUSTMENT
}

enum OrderAdjustmentType {
  DISCOUNT
  TIP
  COMPLIMENT
}

enum PrintJobType {
  KITCHEN
  RECEIPT
}

enum PrintJobStatus {
  PENDING
  CLAIMED
  PRINTED
  FAILED
  CANCELLED
}

enum ReservationStatus {
  HOLD
  CONFIRMED
  CANCELLED
  NO_SHOW
  SEATED
  COMPLETED
  EXPIRED
}

enum ReservationDepositStatus {
  PENDING
  PAID
  REFUNDED
  FORFEITED
}

enum ReservationDepositType {
  FIXED
  PER_PERSON
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  CANCELLED
  EXPIRED
}

enum SalesChannel {
  ONLINE
  LOCAL
}

enum StockMovementType {
  LOCAL_SALE
  LOCAL_SALE_CANCELLED
  MANUAL_ADJUSTMENT
}

enum IngredientUnit {
  GRAM
  MILLILITER
  UNIT
}

enum IngredientMovementType {
  PURCHASE_RECEIPT
  SALE_CONSUMPTION
  SALE_REVERSAL
  WASTE
  MANUAL_ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockStatus {
  RESERVED
  COMMITTED
  RELEASED
}

enum StorageProvider {
  LOCAL
  CLOUDINARY
}

enum NotificationStatus {
  NOT_REQUESTED
  PENDING
  SENDING
  SENT
  FAILED
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum NotificationEvent {
  ORDER_CREATED
  ORDER_PAID
  ORDER_SHIPPED
  ORDER_READY_FOR_PICKUP
  CART_ABANDONED
  RESERVATION_CONFIRMED
  RESERVATION_REMINDER
  RESERVATION_WAITLIST_OFFER
}

enum AnalyticsEventType {
  STOREFRONT_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_STARTED
}

model Tenant {
  id                      String                         @id @default(cuid())
  slug                    String                         @unique
  name                    String
  status                  TenantStatus                   @default(ACTIVE)
  memberships             Membership[]
  branches                Branch[]
  categories              Category[]
  products                Product[]
  productVariants         ProductVariant[]
  customers               Customer[]
  customerSessions        CustomerSession[]
  carts                   Cart[]
  orders                  Order[]
  authSessions            AuthSession[]
  settings                StoreSettings?
  subscription            Subscription?
  mercadoPagoConnection   MercadoPagoConnection?
  mercadoPagoOAuthStates  MercadoPagoOAuthState[]
  paymentAttempts         PaymentAttempt[]
  fiscalProfiles          FiscalProfile[]
  fiscalDocuments         FiscalDocument[]
  paymentReceipts         PaymentReceipt[]
  shipments               Shipment[]
  orderStatusHistory      OrderStatusHistory[]
  teamInvitations         TeamInvitation[]
  billingInvoices         BillingInvoice[]
  customDomains           CustomDomain[]
  coupons                 Coupon[]
  shippingZones           ShippingZone[]
  pickupLocations         PickupLocation[]
  notificationRules       NotificationRule[]
  notificationLogs        NotificationLog[]
  analyticsEvents         AnalyticsEvent[]
  stockMovements          StockMovement[]
  inventoryLocations      InventoryLocation[]
  ingredients             Ingredient[]
  ingredientStocks        IngredientStock[]
  recipeIngredients       RecipeIngredient[]
  ingredientMovements     IngredientMovement[]
  suppliers               Supplier[]
  purchaseOrders          PurchaseOrder[]
  purchaseOrderItems      PurchaseOrderItem[]
  purchaseReceipts        PurchaseReceipt[]
  purchaseReceiptItems    PurchaseReceiptItem[]
  kitchenStations         KitchenStation[]
  orderRounds             OrderRound[]
  kitchenTickets          KitchenTicket[]
  diningOrderAudits       DiningOrderAudit[]
  cashRegisters           CashRegister[]
  cashRegisterSessions    CashRegisterSession[]
  cashMovements           CashMovement[]
  orderPayments           OrderPayment[]
  reservationSchedules    ReservationSchedule[]
  reservations            Reservation[]
  reservationAudits       ReservationAudit[]
  reservationPolicies     ReservationPolicy[]
  reservationExceptions   ReservationScheduleException[]
  reservationDeposits     ReservationDeposit[]
  reservationWaitlist     ReservationWaitlistEntry[]
  modifierGroups          MenuModifierGroup[]
  modifierOptions         MenuModifierOption[]
  orderItemModifiers      OrderItemModifier[]
  orderAdjustments        OrderAdjustment[]
  paymentAllocations      OrderPaymentAllocation[]
  diningTableGroups       DiningTableGroup[]
  diningTableGroupMembers DiningTableGroupMember[]
  printJobs               PrintJob[]
  supportAccessLogs       SupportAccessLog[]
  lastActiveUsers         User[]                         @relation("UserLastTenant")
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  firstName               String
  lastName                String
  platformRole            PlatformRole             @default(USER)
  emailVerifiedAt         DateTime?
  lastTenantId            String?
  lastTenant              Tenant?                  @relation("UserLastTenant", fields: [lastTenantId], references: [id], onDelete: SetNull)
  memberships             Membership[]
  branchMemberships       MembershipBranch[]
  authSessions            AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sentTeamInvitations     TeamInvitation[]         @relation("TeamInvitationInviter")
  mercadoPagoOAuthStates  MercadoPagoOAuthState[]
  orderStatusChanges      OrderStatusHistory[]
  localSales              Order[]                  @relation("LocalSaleSeller")
  stockMovements          StockMovement[]
  ingredientMovements     IngredientMovement[]
  createdPurchaseOrders   PurchaseOrder[]          @relation("PurchaseOrderCreatedBy")
  purchaseReceipts        PurchaseReceipt[]
  openedDiningOrders      Order[]                  @relation("DiningOrderOpener")
  submittedOrderRounds    OrderRound[]
  claimedKitchenTickets   KitchenTicket[]
  diningOrderAudits       DiningOrderAudit[]
  openedCashSessions      CashRegisterSession[]    @relation("CashSessionOpenedBy")
  closedCashSessions      CashRegisterSession[]    @relation("CashSessionClosedBy")
  cashMovements           CashMovement[]
  orderPayments           OrderPayment[]
  paymentAttempts         PaymentAttempt[]
  createdReservations     Reservation[]            @relation("ReservationCreator")
  reservationAudits       ReservationAudit[]
  reservationDeposits     ReservationDeposit[]
  orderAdjustments        OrderAdjustment[]
  diningTableGroups       DiningTableGroup[]
  claimedPrintJobs        PrintJob[]               @relation("PrintJobClaimedBy")
  supportAccessLogs       SupportAccessLog[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([lastTenantId])
}

model Plan {
  id                   String         @id
  code                 PlanCode       @unique
  name                 String
  description          String?
  priceInCents         Int
  currency             String         @default("ARS")
  maxProducts          Int
  maxMembers           Int
  maxOrdersPerMonth    Int?
  trialDays            Int            @default(7)
  features             String[]       @default([])
  active               Boolean        @default(true)
  subscriptions        Subscription[]
  pendingSubscriptions Subscription[] @relation("PendingSubscriptionPlan")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model Subscription {
  tenantId               String             @id
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  trialEndsAt            DateTime?
  currentPeriodFrom      DateTime?
  currentPeriodTo        DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  pendingPlanId          String?
  billingProvider        BillingProvider?
  providerSubscriptionId String?            @unique
  providerStatus         String?
  providerCheckoutUrl    String?
  payerEmail             String?
  lastPaymentAt          DateTime?
  lastPaymentFailedAt    DateTime?
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  pendingPlan            Plan?              @relation("PendingSubscriptionPlan", fields: [pendingPlanId], references: [id], onDelete: SetNull)
  invoices               BillingInvoice[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([planId, status])
  @@index([pendingPlanId])
}

model BillingInvoice {
  id                String               @id @default(cuid())
  tenantId          String
  provider          BillingProvider
  providerInvoiceId String
  providerPaymentId String?
  status            BillingInvoiceStatus @default(PENDING)
  planCode          PlanCode
  planName          String
  amountInCents     Int
  currency          String
  periodFrom        DateTime?
  periodTo          DateTime?
  paidAt            DateTime?
  failureReason     String?
  rawStatus         String?
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "BillingInvoice_tenantId_fkey")
  subscription      Subscription         @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade, map: "BillingInvoice_subscription_fkey")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([provider, providerInvoiceId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model BillingWebhookEvent {
  id          String          @id
  provider    BillingProvider
  eventType   String
  resourceId  String
  processedAt DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([provider, resourceId])
}

model AuthSession {
  id                    String    @id @default(cuid())
  tokenHash             String    @unique
  userId                String
  activeTenantId        String
  activeBranchId        String
  supportOriginTenantId String?
  supportStartedAt      DateTime?
  expiresAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant          Tenant    @relation(fields: [activeTenantId], references: [id], onDelete: Cascade)
  activeBranch          Branch    @relation("AuthSessionActiveBranch", fields: [activeTenantId, activeBranchId], references: [tenantId, id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([activeTenantId, userId])
  @@index([activeTenantId, activeBranchId])
  @@index([expiresAt])
}

model SupportAccessLog {
  id        String    @id @default(cuid())
  userId    String
  tenantId  String
  sessionId String
  reason    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([tenantId, startedAt])
  @@index([sessionId, endedAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model TeamInvitation {
  id              String         @id @default(cuid())
  tenantId        String
  email           String
  role            MembershipRole @default(STAFF)
  tokenHash       String         @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy       User           @relation("TeamInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, acceptedAt, expiresAt])
  @@index([invitedByUserId])
}

model Membership {
  tenantId  String
  userId    String
  role      MembershipRole     @default(STAFF)
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  branches  MembershipBranch[]
  createdAt DateTime           @default(now())

  @@id([tenantId, userId])
  @@index([userId])
}

model Branch {
  id                    String                         @id @default(cuid())
  tenantId              String
  slug                  String
  name                  String
  status                BranchStatus                   @default(ACTIVE)
  isPrimary             Boolean                        @default(false)
  timezone              String                         @default("America/Argentina/Buenos_Aires")
  address               String?
  city                  String?
  province              String?
  postalCode            String?
  phone                 String?
  tenant                Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships           MembershipBranch[]
  sectors               Sector[]
  tables                RestaurantTable[]
  orders                Order[]
  activeSessions        AuthSession[]                  @relation("AuthSessionActiveBranch")
  menuItems             BranchMenuItem[]
  kitchenStations       KitchenStation[]
  orderRounds           OrderRound[]
  kitchenTickets        KitchenTicket[]
  diningAudits          DiningOrderAudit[]
  cashRegisters         CashRegister[]
  cashSessions          CashRegisterSession[]
  cashMovements         CashMovement[]
  orderPayments         OrderPayment[]
  paymentAttempts       PaymentAttempt[]
  fiscalProfile         FiscalProfile?
  fiscalDocuments       FiscalDocument[]
  reservationSchedules  ReservationSchedule[]
  reservations          Reservation[]
  reservationAudits     ReservationAudit[]
  reservationPolicy     ReservationPolicy?
  reservationExceptions ReservationScheduleException[]
  reservationDeposits   ReservationDeposit[]
  reservationWaitlist   ReservationWaitlistEntry[]
  modifierGroups        MenuModifierGroup[]
  tableGroups           DiningTableGroup[]
  tableGroupMembers     DiningTableGroupMember[]
  orderAdjustments      OrderAdjustment[]
  paymentAllocations    OrderPaymentAllocation[]
  printJobs             PrintJob[]
  inventoryLocations    InventoryLocation[]
  ingredientStocks      IngredientStock[]
  ingredientMovements   IngredientMovement[]
  purchaseOrders        PurchaseOrder[]
  purchaseReceipts      PurchaseReceipt[]
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  menuModifierOptions   MenuModifierOption[]

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model MembershipBranch {
  tenantId   String
  branchId   String
  userId     String
  role       BranchRole      @default(STAFF)
  stationId  String?
  membership Membership      @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  branch     Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  station    KitchenStation? @relation(fields: [tenantId, branchId, stationId], references: [tenantId, branchId, id], onDelete: Restrict)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@id([tenantId, branchId, userId])
  @@index([tenantId, userId])
  @@index([tenantId, branchId, stationId])
  @@index([userId])
}

model Sector {
  id        String            @id @default(cuid())
  tenantId  String
  branchId  String
  name      String
  sortOrder Int               @default(0)
  active    Boolean           @default(true)
  branch    Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  tables    RestaurantTable[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([tenantId, branchId, name])
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, active])
}

model RestaurantTable {
  id            String                   @id @default(cuid())
  tenantId      String
  branchId      String
  sectorId      String?
  code          String
  name          String
  minCapacity   Int                      @default(1)
  maxCapacity   Int
  status        TableStatus              @default(AVAILABLE)
  branch        Branch                   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  sector        Sector?                  @relation(fields: [tenantId, branchId, sectorId], references: [tenantId, branchId, id], onDelete: Restrict)
  orders        Order[]
  reservations  Reservation[]
  primaryGroups DiningTableGroup[]       @relation("DiningTableGroupPrimary")
  groupMembers  DiningTableGroupMember[] @relation("DiningTableGroupTable")
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([tenantId, branchId, code])
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, sectorId])
}

model ReservationSchedule {
  id              String   @id @default(cuid())
  tenantId        String
  branchId        String
  weekday         Int
  opensAtMinutes  Int
  closesAtMinutes Int
  active          Boolean  @default(true)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, branchId, weekday])
  @@index([tenantId, branchId, active])
}

model ReservationPolicy {
  tenantId                String
  branchId                String
  reminderHours           Int                    @default(24)
  cancellationCutoffHours Int                    @default(2)
  depositRequired         Boolean                @default(false)
  depositType             ReservationDepositType @default(FIXED)
  depositAmountInCents    Int                    @default(0)
  tenant                  Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                  Branch                 @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@id([tenantId, branchId])
}

model ReservationScheduleException {
  id              String   @id @default(cuid())
  tenantId        String
  branchId        String
  date            DateTime @db.Date
  closed          Boolean  @default(true)
  opensAtMinutes  Int?
  closesAtMinutes Int?
  reason          String?
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, branchId, date])
  @@index([tenantId, branchId, date])
}

model Reservation {
  id              String                     @id @default(cuid())
  tenantId        String
  branchId        String
  tableId         String
  status          ReservationStatus          @default(HOLD)
  partySize       Int
  customerName    String
  customerPhone   String
  customerEmail   String?
  notes           String?
  startsAt        DateTime
  endsAt          DateTime
  holdExpiresAt   DateTime?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  noShowAt        DateTime?
  seatedAt        DateTime?
  completedAt     DateTime?
  clientRequestId String
  manageTokenHash String                     @unique
  createdByUserId String?
  customerId      String?
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch                     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  table           RestaurantTable            @relation(fields: [tenantId, branchId, tableId], references: [tenantId, branchId, id], onDelete: Restrict)
  createdBy       User?                      @relation("ReservationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  customer        Customer?                  @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  audits          ReservationAudit[]
  deposits        ReservationDeposit[]
  notifications   NotificationLog[]
  waitlistEntries ReservationWaitlistEntry[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([tenantId, clientRequestId])
  @@unique([tenantId, id])
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, startsAt, status])
  @@index([status, holdExpiresAt])
  @@index([tableId, startsAt, endsAt])
  @@index([tenantId, customerId, startsAt])
}

model ReservationDeposit {
  id               String                   @id @default(cuid())
  tenantId         String
  branchId         String
  reservationId    String
  status           ReservationDepositStatus @default(PENDING)
  amountInCents    Int
  method           PaymentMethod?
  reference        String?
  clientRequestId  String
  receivedByUserId String?
  paidAt           DateTime?
  resolvedAt       DateTime?
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch                   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  reservation      Reservation              @relation(fields: [tenantId, branchId, reservationId], references: [tenantId, branchId, id], onDelete: Cascade)
  receivedBy       User?                    @relation(fields: [receivedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([tenantId, clientRequestId])
  @@unique([tenantId, id])
  @@index([tenantId, branchId, reservationId])
}

model ReservationWaitlistEntry {
  id               String         @id @default(cuid())
  tenantId         String
  branchId         String
  reservationId    String?
  status           WaitlistStatus @default(WAITING)
  requestedDate    DateTime       @db.Date
  preferredMinutes Int?
  partySize        Int
  durationMinutes  Int            @default(90)
  customerName     String
  customerPhone    String
  customerEmail    String?
  notes            String?
  clientRequestId  String
  offerExpiresAt   DateTime?
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  reservation      Reservation?   @relation(fields: [tenantId, branchId, reservationId], references: [tenantId, branchId, id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([tenantId, clientRequestId])
