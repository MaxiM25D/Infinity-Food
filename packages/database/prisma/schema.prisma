  id        String            @id @default(cuid())
  tenantId  String
  event     NotificationEvent
  active    Boolean           @default(true)
  subject   String
  message   String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([tenantId, event])
  @@index([tenantId, active])
}

model NotificationLog {
  id            String             @id @default(cuid())
  tenantId      String
  orderId       String?
  reservationId String?
  event         NotificationEvent
  recipient     String
  subject       String             @default("")
  message       String             @default("")
  actionUrl     String             @default("")
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now())
  lockedAt      DateTime?
  error         String?
  sentAt        DateTime?
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order         Order?             @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  reservation   Reservation?       @relation(fields: [tenantId, reservationId], references: [tenantId, id], onDelete: Cascade)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([tenantId, reservationId, event])
  @@index([tenantId, event, createdAt])
  @@index([tenantId, orderId, createdAt])
  @@index([tenantId, reservationId, createdAt])
  @@index([status, nextAttemptAt])
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  tenantId  String
  type      AnalyticsEventType
  productId String?
  sessionId String?
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@index([tenantId, type, createdAt])
  @@index([tenantId, productId, createdAt])
}
