  shippingEstimatedDaysMin     Int?
  shippingEstimatedDaysMax     Int?
  shippingFreeThresholdInCents Int?
  shippingCarrierCode          String?
  shippingCarrierName          String?
  shippingTrackingUrlTemplate  String?
  shippingPolicySnapshot       String?
  returnPolicySnapshot         String?
  fulfillmentType              FulfillmentType      @default(DELIVERY)
  pickupLocationName           String?
  pickupAddress                String?
  pickupMapsUrl                String?
  pickupOpeningHours           String?
  pickupInstructions           String?
  pickupPhone                  String?
  pickupReadyAt                DateTime?
  pickupCompletedAt            DateTime?
  diningSource                 DiningOrderSource?
  diningStatus                 DiningOrderStatus?
  restaurantTableId            String?
  openedByUserId               String?
  diningOpenedAt               DateTime?
  diningClosedAt               DateTime?
  totalInCents                 Int
  tenant                       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                       Branch               @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  restaurantTable              RestaurantTable?     @relation(fields: [tenantId, branchId, restaurantTableId], references: [tenantId, branchId, id], onDelete: Restrict)
  customer                     Customer?            @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  items                        OrderItem[]
  paymentAttempts              PaymentAttempt[]
  operationalPayments          OrderPayment[]
  paymentReceipt               PaymentReceipt?
  shipment                     Shipment?
  notificationLogs             NotificationLog[]
  statusHistory                OrderStatusHistory[]
  soldBy                       User?                @relation("LocalSaleSeller", fields: [soldByUserId], references: [id], onDelete: SetNull)
  openedBy                     User?                @relation("DiningOrderOpener", fields: [openedByUserId], references: [id], onDelete: SetNull)
  rounds                       OrderRound[]
  diningAudits                 DiningOrderAudit[]
