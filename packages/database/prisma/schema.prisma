  @@unique([tenantId, id])
  @@unique([tenantId, branchId, id])
  @@index([tenantId, status])
  @@index([tenantId, branchId, status])
  @@index([tenantId, branchId, diningStatus, createdAt])
  @@index([tenantId, branchId, restaurantTableId, diningStatus])
  @@index([tenantId, stockStatus, stockExpiresAt])
  @@index([tenantId, customerId])
  @@index([tenantId, channel, createdAt])
  @@index([soldByUserId])
}

