NODE_ENV=production
APP_VERSION=git-commit-sha
# Durante el piloto: allowlist. Para congelar altas: closed. Al abrir al público: open.
PILOT_SIGNUP_MODE=allowlist
PILOT_ALLOWED_EMAILS=owner@restaurante-piloto.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
API_PUBLIC_URL=https://api.tudominio.com
WEB_URL=https://app.tudominio.com
NEXT_PUBLIC_SITE_URL=https://app.tudominio.com
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
METRICS_TOKEN=
REDIS_URL=redis://REDIS_HOST:6379
REDIS_KEY_PREFIX=infinityfood-production
WORKER_HEARTBEAT_TTL_SECONDS=30
REPORT_AGGREGATE_INTERVAL_MS=5000
# Presupuesto: réplicas × DATABASE_POOL_MAX + worker + migraciones debe quedar bajo max_connections.
DATABASE_POOL_MAX=8
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# Bootstrap inicial. Guardar estos valores como secretos del servicio API.
# Si el usuario ya existe, los despliegues posteriores conservan su contraseña y sesiones.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_STORE_SLUG=infinityfood-demo
DEMO_STORE_SLUG=infinityfood-demo

SESSION_TTL_DAYS=7
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=.tudominio.com
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
TEAM_INVITATION_TTL_DAYS=7

# Recomendado en Railway: API HTTPS de Resend. SMTP está bloqueado en Hobby.
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@emails.tudominio.com
EMAIL_SEND_TIMEOUT_MS=8000
EMAIL_QUEUE_INTERVAL_MS=5000
EMAIL_QUEUE_MAX_ATTEMPTS=5
RESEND_API_KEY=

STORAGE_PROVIDER=cloudinary
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
PUBLIC_UPLOAD_DIR=storage/public
PRIVATE_UPLOAD_DIR=storage/private

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@tudominio.com

MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_TOKEN_ENCRYPTION_KEY=

# Facturación de InfinityFood; no usar tokens OAuth de tenants.
SAAS_BILLING_PROVIDER=mercado_pago
SAAS_MP_ACCESS_TOKEN=
SAAS_MP_WEBHOOK_SECRET=

RESERVATION_SWEEP_INTERVAL_MS=60000
