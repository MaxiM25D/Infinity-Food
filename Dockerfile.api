FROM node:22-alpine AS builder

ENV CI=true
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile

COPY apps/api apps/api
COPY packages packages
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build pnpm db:generate \
    && pnpm --filter @infinityshop/database build \
    && pnpm --filter @infinityshop/api build \
    && pnpm install --prod --offline --frozen-lockfile

FROM node:22-alpine AS runner

ENV NODE_ENV=production
ENV DEMO_STORE_SLUG=infinityshop-demo
WORKDIR /app

RUN corepack enable && addgroup -S infinityshop && adduser -S infinityshop -G infinityshop
COPY --from=builder --chown=infinityshop:infinityshop /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=builder --chown=infinityshop:infinityshop /app/node_modules ./node_modules
COPY --from=builder --chown=infinityshop:infinityshop /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=infinityshop:infinityshop /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder --chown=infinityshop:infinityshop /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=infinityshop:infinityshop /app/packages/database/package.json ./packages/database/package.json
COPY --from=builder --chown=infinityshop:infinityshop /app/packages/database/node_modules ./packages/database/node_modules
COPY --from=builder --chown=infinityshop:infinityshop /app/packages/database/dist ./packages/database/dist
COPY --from=builder --chown=infinityshop:infinityshop /app/packages/database/prisma ./packages/database/prisma
COPY --from=builder --chown=infinityshop:infinityshop /app/packages/database/prisma.config.ts ./packages/database/prisma.config.ts
RUN mkdir -p storage/public storage/private && chown -R infinityshop:infinityshop storage

USER infinityshop
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/api/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/api/dist/server.js"]
