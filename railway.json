{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.api",
    "watchPatterns": [
      "apps/api/**",
      "packages/database/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "turbo.json",
      "Dockerfile.api",
      "railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": ["pnpm db:prepare:prod"],
    "healthcheckPath": "/api/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
