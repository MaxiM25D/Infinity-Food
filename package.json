{
  "name": "infinityfood",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:up && concurrently -k -n api,worker,web \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @infinityshop/web dev",
    "dev:api": "pnpm --filter @infinityshop/database build && pnpm --filter @infinityshop/api dev",
    "dev:worker": "pnpm --filter @infinityshop/database build && pnpm --filter @infinityshop/api dev:worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @infinityshop/database db:generate",
    "db:migrate": "pnpm --filter @infinityshop/database db:migrate",
    "db:deploy": "pnpm --filter @infinityshop/database exec prisma migrate deploy --config prisma.config.ts",
    "db:seed": "pnpm --filter @infinityshop/database db:seed",
    "db:studio": "pnpm --filter @infinityshop/database db:studio",
    "db:test:isolation": "pnpm --filter @infinityshop/database test:isolation",
    "db:superadmin": "pnpm --filter @infinityshop/database db:superadmin",
    "db:demo": "pnpm --filter @infinityshop/database db:demo",
    "db:demo:prod": "pnpm --filter @infinityshop/database db:demo:prod",
    "db:prepare:prod": "pnpm db:deploy && pnpm db:demo:prod && pnpm --filter @infinityshop/database db:bootstrap-superadmin:prod",
    "test:api": "pnpm --filter @infinityshop/database build && pnpm --filter @infinityshop/api test",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "test:load": "node scripts/load-test.mjs",
    "test:e2e": "playwright test",
    "test:scale": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-horizontal-scale.ps1",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-postgres.ps1",
    "db:restore:drill": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-drill.ps1",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "staging:up": "docker compose -f compose.staging.yaml up -d --build --wait",
    "staging:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/staging-smoke.ps1",
    "staging:down": "docker compose -f compose.staging.yaml down",
    "pilot:check": "node scripts/pilot-readiness.mjs",
    "pilot:recovery": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pilot-recovery-drill.ps1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^10.0.6",
    "turbo": "2.11.8"
  }
}
