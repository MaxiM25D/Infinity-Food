POSTGRES_DB=lunek_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lunek_saas?schema=public"
API_PORT=4000
# Algunos proveedores inyectan PORT automáticamente; dejalo vacío en local.
PORT=""
APP_VERSION="development"
API_PUBLIC_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
API_INTERNAL_URL="http://localhost:4000/api"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
PLATFORM_HOSTS="localhost,127.0.0.1,infinityfood.com.ar,www.infinityfood.com.ar"
NODE_ENV=development
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
METRICS_TOKEN=
SESSION_TTL_DAYS=7
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=""
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
TEAM_INVITATION_TTL_DAYS=7
EMAIL_PROVIDER=smtp
EMAIL_FROM=""
RESEND_API_KEY=""
EMAIL_SEND_TIMEOUT_MS=8000
EMAIL_QUEUE_INTERVAL_MS=5000
EMAIL_QUEUE_MAX_ATTEMPTS=5

SUPERADMIN_EMAIL="superadmin@infinityfood.local"
SUPERADMIN_PASSWORD="cambiar-por-una-clave-segura"
SUPERADMIN_STORE_SLUG="infinityshop-demo"

# Mercado Pago OAuth por tienda. El callback configurado en tu aplicación debe ser:
# http://localhost:4000/api/integrations/mercadopago/callback
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_WEBHOOK_SECRET=""
# Una clave aleatoria de al menos 32 caracteres. No se comparte con el frontend.
MP_TOKEN_ENCRYPTION_KEY=""

# Cobro de planes InfinityFood (credenciales propias, separadas de las tiendas)
SAAS_BILLING_PROVIDER=disabled
SAAS_MP_ACCESS_TOKEN=""
SAAS_MP_WEBHOOK_SECRET=""

# Proveedor fiscal homologado (adaptador HTTP; separado de Mercado Pago y del billing SaaS)
FISCAL_PROVIDER_URL=""
FISCAL_PROVIDER_TOKEN=""

SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Cloudinary es opcional. Sin estas variables, desarrollo usa storage/public y storage/private.
CLOUDINARY_NAME=""
CLOUDINARY_KEY=""
CLOUDINARY_SECRET=""
STORAGE_PROVIDER=local
PUBLIC_UPLOAD_DIR="storage/public"
PRIVATE_UPLOAD_DIR="storage/private"
RESERVATION_SWEEP_INTERVAL_MS=60000
